+static int lib_shake(struct unit_test_state *uts)
+{
+	static const u8 shake128_empty[32] = {
+		0x7f, 0x9c, 0x2b, 0xa4, 0xe8, 0x8f, 0x82, 0x7d,
+		0x61, 0x60, 0x45, 0x50, 0x76, 0x05, 0x85, 0x3e,
