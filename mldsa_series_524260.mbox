Adapt the Linux KUnit coverage introduced by commit
ed894faccb8de55cd755e093c4b0971f190d384d to the U-Boot unit-test
framework. Import its fixed vectors for ML-DSA-44, ML-DSA-65 and
ML-DSA-87.

Use deterministic mutation positions for reproducible U-Boot tests.
Test valid signatures for every parameter set. Test signature and
public-key length errors plus a changed message length. Test malformed
encodings and every valid UseHint input.

Add an invalid-algorithm test beyond the Linux coverage. Test SHAKE128
and SHAKE256 against FIPS 202 known answers.

Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
 test/Kconfig              |    9 +
 test/lib/Makefile         |    1 +
 test/lib/mldsa-testvecs.h | 1896 +++++++++++++++++++++++++++++++++++++
 test/lib/mldsa.c          |  383 ++++++++
 4 files changed, 2289 insertions(+)
 create mode 100644 test/lib/mldsa-testvecs.h
 create mode 100644 test/lib/mldsa.c

diff --git a/test/Kconfig b/test/Kconfig
index 14b5b0e2a9a..1363848fb5e 100644
--- a/test/Kconfig
+++ b/test/Kconfig
@@ -75,6 +75,15 @@ config UT_LIB_RSA
 	  Enables rsa_verify() test, currently rsa_verify_with_pkey only()
 	  only, at the 'ut lib' command.
 
+config UT_LIB_MLDSA
+	bool "Unit tests for ML-DSA verification"
+	default y
+	select MLDSA_VERIFY
+	help
+	  Enables fixed-vector tests for all three FIPS 204 ML-DSA parameter
+	  sets. Tests cover malformed encodings, input mutations and the
+	  complete UseHint input space at the 'ut lib' command.
+
 endif  # UT_LIB
 
 config UT_BOOTSTD
diff --git a/test/lib/Makefile b/test/lib/Makefile
index f25383a40e5..35ac9574d95 100644
--- a/test/lib/Makefile
+++ b/test/lib/Makefile
@@ -28,6 +28,7 @@ obj-y += strlcat.o
 obj-$(CONFIG_ERRNO_STR) += test_errno_str.o
 obj-$(CONFIG_UT_LIB_ASN1) += asn1.o
 obj-$(CONFIG_UT_LIB_RSA) += rsa.o
+obj-$(CONFIG_UT_LIB_MLDSA) += mldsa.o
 obj-$(CONFIG_AES) += test_aes.o
 obj-$(CONFIG_SHA256) += test_sha256_hmac.o
 obj-$(CONFIG_HKDF_MBEDTLS) += test_sha256_hkdf.o
diff --git a/test/lib/mldsa-testvecs.h b/test/lib/mldsa-testvecs.h
new file mode 100644
index 00000000000..7ae3cb627b1
--- /dev/null
+++ b/test/lib/mldsa-testvecs.h
@@ -0,0 +1,1896 @@
+/* SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause */
+/*
+ * ML-DSA test vectors extracted from leancrypto.
+ *
+ * Based on Linux lib/crypto/tests/mldsa-testvecs.h
+ * at commit:
+ * https://git.kernel.org/linus/ed894faccb8de55cd755e093c4b0971f190d384d
+ *
+ * Ported to U-Boot by:
+ * Ayoub Zaki <ayoub.zaki@embetrix.com>
+ */
+
+struct mldsa_testvector {
+	enum mldsa_alg alg;
+	int sig_len;
+	int msg_len;
+	int pk_len;
+	const u8 *sig;
+	const u8 *msg;
+	const u8 *pk;
+};
+
+static const struct mldsa_testvector mldsa44_testvector = {
+	.alg = MLDSA44,
+	.pk_len = MLDSA44_PUBLIC_KEY_SIZE,
+	.pk =
